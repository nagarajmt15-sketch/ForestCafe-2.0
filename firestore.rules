rules_version = '2';

// Forest Cafe - Firestore security rules
// Everyone can READ the website content. Only the owner can WRITE it.
service cloud.firestore {
  match /databases/{database}/documents {

    match /site/content {
      allow read: if true;

      // !! DUMMY VALUE !!  Replace PASTE_OWNER_UID_HERE with the owner's UID:
      // Firebase Console > Authentication > Users > copy the "User UID" of the owner.
      allow write: if request.auth != null
                   && request.auth.uid == 'PASTE_OWNER_UID_HERE'
                   && request.resource.data.json is string
                   && request.resource.data.json.size() < 30000;
    }

    // everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
